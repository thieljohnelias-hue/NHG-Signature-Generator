<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',system-ui,sans-serif;background:#f5f4f0;color:#1a1a1a;min-height:100vh;padding:2rem}
.page{max-width:820px;margin:0 auto}
.header{display:flex;align-items:center;gap:12px;margin-bottom:2rem}
.hl{width:36px;height:36px;background:#1a1a1a;border-radius:8px;display:flex;align-items:center;justify-content:center}
.hl span{color:#fbad18;font-size:7px;font-weight:600;line-height:1.2;text-align:center}
.header h1{font-size:15px;font-weight:600}
.header p{font-size:12px;color:#888;margin-top:1px}
.card{background:#fff;border-radius:16px;border:0.5px solid #e0ddd6;padding:1.5rem;margin-bottom:1.25rem}
.ct{font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#aaa;margin-bottom:1rem}
.brand-tabs{display:flex;gap:8px;margin-bottom:1.25rem;flex-wrap:wrap}
.bt{padding:7px 14px;border-radius:20px;border:1px solid #e0ddd6;background:transparent;font-family:'DM Sans',system-ui,sans-serif;font-size:12px;font-weight:500;cursor:pointer;color:#666;transition:all .15s}
.bt:hover{border-color:#ccc;color:#333}
.bt.a-nhg{background:#005aaa;border-color:#005aaa;color:#fff}
.bt.a-notiz{background:#541e1e;border-color:#541e1e;color:#fff}
.bt.a-wannee{background:#193d35;border-color:#193d35;color:#fff}
.bt.a-meetingu{background:#009baa;border-color:#009baa;color:#fff}
.bt.a-reservations{background:linear-gradient(90deg,#541e1e 50%,#193d35 50%);border-color:#541e1e;color:#fff}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fg{display:flex;flex-direction:column;gap:4px}
.fg label{font-size:11px;font-weight:500;color:#999;letter-spacing:.04em}
.fg input{padding:9px 12px;border:0.5px solid #e0ddd6;border-radius:8px;font-family:'DM Sans',system-ui,sans-serif;font-size:13px;color:#1a1a1a;background:#fafaf8;outline:none;transition:border-color .15s}
.fg input:focus{border-color:#fbad18;background:#fff}
.fg input::placeholder{color:#bbb}
.opt{font-size:10px;color:#bbb;font-weight:400;margin-left:4px}
hr.div{border:none;border-top:0.5px solid #f0efe9;margin:1rem 0}
.days{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
.dc{display:flex;align-items:center;gap:5px;font-size:12px;color:#555;cursor:pointer}
.dc input{accent-color:#fbad18;width:14px;height:14px;cursor:pointer}
.pl{font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#aaa;margin-bottom:.75rem}
.preview{background:#fff;border-radius:12px;border:0.5px solid #e0ddd6;overflow:hidden;margin-bottom:1.25rem;padding:4px}
.btn-row{display:flex;gap:10px}
.btn{padding:10px 20px;border-radius:8px;border:none;font-family:'DM Sans',system-ui,sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:all .15s}
.btn-p{background:#1a1a1a;color:#fff}
.btn-p:hover{background:#333}
.btn-s{background:#f0efe9;color:#555;border:0.5px solid #e0ddd6}
