</head>
<body>
<div class="page">
  <div class="header">
    <div class="hl"><span>NHL<br>STENDEN</span></div>
    <div><h1>NHG Email Signature Generator</h1><p>All brands &middot; Final version</p></div>
  </div>

  <div class="card">
    <div class="ct">1. Choose brand</div>
    <div class="brand-tabs">
      <button class="bt a-nhg"          onclick="setBrand('nhg',this)">NHL Stenden Hospitality Group</button>
      <button class="bt"                onclick="setBrand('notiz',this)">Notiz Hotel</button>
      <button class="bt"                onclick="setBrand('wannee',this)">Restaurant Wannee</button>
      <button class="bt"                onclick="setBrand('meetingu',this)">Meeting u</button>
      <button class="bt"                onclick="setBrand('reservations',this)">Reservations | NHG</button>
    </div>

    <div class="ct">2. Personal details</div>
    <div class="fields">
      <div class="fg"><label>Full name</label><input id="f-name" type="text" placeholder="e.g. Jan de Vries" autocomplete="off" oninput="update()"></div>
      <div class="fg"><label>Job title</label><input id="f-role" type="text" placeholder="e.g. Practical Facilitator" autocomplete="off" oninput="update()"></div>
      <div class="fg"><label>Department</label><input id="f-dept" type="text" placeholder="e.g. Reservations" autocomplete="off" oninput="update()"></div>
      <div class="fg"><label>T: phone number <span class="opt">optional</span></label><input id="f-phone" type="text" placeholder="e.g. +31 58 100 0000" autocomplete="off" oninput="formatPhone(this);update()"></div>
      <div class="fg"><label>M: mobile number <span class="opt">optional</span></label><input id="f-phone2" type="text" placeholder="e.g. +31 6 00 00 00 00" autocomplete="off" oninput="formatPhone(this);update()"></div>
      <div class="fg"><label>Email address <span class="opt">(if using shared mailbox)</span></label><input id="f-email" type="text" placeholder="shared@nhlstenden.com" autocomplete="off" oninput="update()"></div>
    </div>

    <hr class="div">
    <div class="ct">Working days <span class="opt">optional &mdash; leave unchecked to hide</span></div>
    <div class="days">
      <label class="dc"><input type="checkbox" id="d-mon" onchange="update()"> Monday</label>
      <label class="dc"><input type="checkbox" id="d-tue" onchange="update()"> Tuesday</label>
      <label class="dc"><input type="checkbox" id="d-wed" onchange="update()"> Wednesday</label>
      <label class="dc"><input type="checkbox" id="d-thu" onchange="update()"> Thursday</label>
      <label class="dc"><input type="checkbox" id="d-fri" onchange="update()"> Friday</label>
    </div>

    <hr class="div">
    <div class="ct">3. Links &amp; socials</div>
    <div class="fields">
      <div class="fg">
        <label>Website display text <span class="opt">what people see</span></label>
        <input id="f-webtext" type="text" placeholder="e.g. Food &amp; Drinks | NHL Stenden" autocomplete="off" oninput="update()">
      </div>
      <div class="fg">
        <label>Website URL <span class="opt">the actual link</span></label>
        <input id="f-weburl" type="text" placeholder="e.g. https://www.nhlstenden.com" autocomplete="off" oninput="update()">
      </div>
      <div class="fg"><label class="il"><img id="li-icon" src="" alt="">LinkedIn URL <span class="opt">optional</span></label><input id="f-linkedin" type="text" placeholder="https://www.linkedin.com/..." autocomplete="off" oninput="update()"></div>
      <div class="fg"><label class="il"><img id="ig-icon" src="" alt="">Instagram URL <span class="opt">optional</span></label><input id="f-instagram" type="text" placeholder="https://www.instagram.com/..." autocomplete="off" oninput="update()"></div>
    </div>
  </div>

  <div class="card">
    <div class="pl">4. Preview</div>
    <div class="preview" id="preview"></div>
    <div class="btn-row">
      <button class="btn btn-p" onclick="copySig()">Copy signature</button>
      <button class="btn btn-s" onclick="showCode()">View HTML code</button>
    </div>
    <pre class="code" id="code"></pre>
  </div>

  <div class="instr">
    <h3>How to add to your email client</h3>
    <ol>
      <li>Fill in your details, then click <span>Copy signature</span></li>
      <li><span>Outlook:</span> File &rarr; Options &rarr; Mail &rarr; Signatures &rarr; New &rarr; paste</li>
      <li><span>Gmail:</span> Settings &rarr; See all settings &rarr; General &rarr; Signature &rarr; paste</li>
      <li>Send a test email to yourself to verify it looks correct</li>
    </ol>
  </div>
</div>
<div class="toast" id="toast">Signature copied to clipboard!</div>

