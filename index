var DAYS = [['d-mon','Monday'],['d-tue','Tuesday'],['d-wed','Wednesday'],['d-thu','Thursday'],['d-fri','Friday']];
var current = 'nhg';

function setBrand(key, el) {
  current = key;
  document.querySelectorAll('.bt').forEach(function(t){ t.className = 'bt'; });
  el.className = 'bt ' + brands[key].tab;
  var b = brands[key];
  document.getElementById('f-webtext').value   = b.webText;
  document.getElementById('f-weburl').value    = b.webUrl;
  document.getElementById('f-linkedin').value  = b.linkedin;
  document.getElementById('f-instagram').value = b.instagram;
  document.getElementById('f-phone').value     = '';
  document.getElementById('f-phone2').value    = '';
  update();
}

function getWD() {
  var checked = DAYS.filter(function(d){ return document.getElementById(d[0]).checked; }).map(function(d){ return d[1]; });
  return checked.length ? 'WD: ' + checked.join(' | ') : '';
}

function formatPhone(input) {
  var raw = input.value.replace(/[^\d+]/g, '');
  var f = '';
  if (raw.startsWith('+31')) {
    var loc = raw.slice(3);
    if (loc.startsWith('6')) {
      f = '+31 6' +
        (loc.length > 1 ? ' ' + loc.slice(1,3) : '') +
        (loc.length > 3 ? ' ' + loc.slice(3,5) : '') +
        (loc.length > 5 ? ' ' + loc.slice(5,7) : '') +
        (loc.length > 7 ? ' ' + loc.slice(7,9) : '');
    } else {
      f = '+31' +
        (loc.length > 0 ? ' ' + loc.slice(0,2) : '') +
        (loc.length > 2 ? ' ' + loc.slice(2,5) : '') +
        (loc.length > 5 ? ' ' + loc.slice(5,7) : '') +
        (loc.length > 7 ? ' ' + loc.slice(7,9) : '');
    }
  } else if (raw.startsWith('+')) {
    var c = raw.slice(1);
    f = '+' + c.slice(0,2) +
      (c.length > 2 ? ' ' + c.slice(2,5) : '') +
      (c.length > 5 ? ' ' + c.slice(5,8) : '') +
      (c.length > 8 ? ' ' + c.slice(8,12) : '');
  } else {
    f = raw.replace(/(\d{3,4})(?=\d)/g, '$1 ');
  }
  input.value = f;
}

