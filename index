function update() {
  document.getElementById('preview').innerHTML = getSig();
}

function copySig() {
  var html = getSig();
  if (navigator.clipboard && window.ClipboardItem) {
    var blob = new Blob([html], {type:'text/html'});
    navigator.clipboard.write([new ClipboardItem({'text/html': blob})]).then(function(){
      showToast('Signature copied to clipboard!');
    }).catch(function(){ fallbackCopy(html); });
  } else {
    fallbackCopy(html);
  }
}

function fallbackCopy(html) {
  var div = document.createElement('div');
  div.contentEditable = 'true';
  div.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;opacity:0;z-index:9999;background:#fff;padding:20px;';
  div.innerHTML = html;
  document.body.appendChild(div);
  var range = document.createRange();
  range.selectNodeContents(div);
  var sel = window.getSelection();
  sel.removeAllRanges();
  sel.addRange(range);
  var ok = false;
  try { ok = document.execCommand('copy'); } catch(e) {}
  sel.removeAllRanges();
  document.body.removeChild(div);
  if (ok) {
    showToast('Signature copied to clipboard!');
  } else {
    showCode();
    showToast('Please select all text in the box below and copy manually (Ctrl+A, Ctrl+C).');
  }
}

function showToast(msg) {
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.style.display = 'block';
  setTimeout(function(){ t.style.display = 'none'; }, 3500);
}

function showCode() {
  var el = document.getElementById('code');
  if (el.style.display === 'block') { el.style.display = 'none'; return; }
  el.textContent = getSig();
  el.style.display = 'block';
}

