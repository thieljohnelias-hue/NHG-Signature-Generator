.code{display:none;margin-top:1rem;padding:12px;background:#fafaf8;border:0.5px solid #e0ddd6;border-radius:8px;font-size:11px;color:#999;line-height:1.5;white-space:pre-wrap;word-break:break-all}
.instr{background:#fffbf0;border:0.5px solid #fbad18;border-radius:10px;padding:1rem 1.25rem}
.instr h3{font-size:12px;font-weight:600;color:#b8860b;margin-bottom:.5rem}
.instr ol{padding-left:1.1rem;font-size:12px;color:#888;line-height:2}
.instr ol li span{color:#555;font-weight:500}
.toast{display:none;position:fixed;bottom:2rem;left:50%;transform:translateX(-50%);background:#1a1a1a;color:#fff;padding:10px 20px;border-radius:20px;font-size:13px;font-weight:500;z-index:999}
.il{display:flex;align-items:center;gap:6px}
.il img{width:14px;height:14px;opacity:.5}
